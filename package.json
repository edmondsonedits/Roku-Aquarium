{
  "name": "roku-aquarium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node runtime/server.mjs",
    "start:local": "node runtime/server.mjs",
    "dev": "npm run build && node runtime/server.mjs",
    "build": "node standalone/build.mjs",
    "build:local": "node standalone/build.mjs",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs server/tests/*.test.ts standalone/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  }
}
